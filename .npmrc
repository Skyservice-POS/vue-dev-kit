//registry.npmjs.org/:_authToken=${NPM_TOKEN}

# Репозиторій свідомо тримає інструментарій під обидві мажорні версії Vue:
# vue 3 для основної збірки і @vitejs/plugin-vue2 для збірки dist/vue2.
# Плагін оголошує жорсткий peer на vue@^2.7, який кореневим vue 3 не
# задовольняється — npm 7+ через це відмовляється ставити залежності.
# Справжній vue плагіну не потрібен: компілятор передається йому явно
# у vite.vue2.config.js (з пакета vue2, аліаса на vue@2.7.16).
legacy-peer-deps=true
