{
  "name": "@skyservice-developers/vue-dev-kit",
  "version": "2.14.5",
  "description": "Vue 3 component library + TypeScript SDK (iframe bridge + HTTP API) for Skyservice mini-apps",
  "type": "module",
  "main": "./dist/vue-dev-kit.cjs",
  "module": "./dist/vue-dev-kit.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-dev-kit.js",
      "require": "./dist/vue-dev-kit.cjs"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk.js",
      "require": "./dist/sdk.cjs"
    },
    "./vue3": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-dev-kit.js",
      "require": "./dist/vue-dev-kit.cjs"
    },
    "./style.css": "./dist/style.css",
    "./vue3/style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.typecheck.json",
    "prepublishOnly": "npm run build",
    "release": "npm publish --access public"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@tanstack/vue-table": "^9.1.2",
    "@tanstack/vue-virtual": "^3.13.36",
    "sky-service-ui-components": "^0.1.3",
    "ua-parser-js": "^1.0.37"
  },
  "devDependencies": {
    "@types/ua-parser-js": "^0.7.39",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/test-utils": "^2.5.0",
    "happy-dom": "^20.12.0",
    "sass": "^1.77.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^3.9.1",
    "vite-svg-loader": "^5.1.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11",
    "vue": "^3.4.21",
    "vue-tsc": "^3.0.0"
  },
  "keywords": [
    "vue",
    "vue3",
    "components",
    "toolkit",
    "ui",
    "skyservice",
    "sdk",
    "iframe",
    "bridge"
  ],
  "author": "Skyservice-POS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Skyservice-POS/vue-dev-kit.git"
  },
  "bugs": {
    "url": "https://github.com/Skyservice-POS/vue-dev-kit/issues"
  },
  "homepage": "https://github.com/Skyservice-POS/vue-dev-kit#readme"
}
